# Django Settings
SECRET_KEY=django-insecure-change-this-in-production-key-1234567890
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Settings (Leave empty for SQLite in dev, or set postgres URL e.g. postgresql://user:password@localhost:5432/cert_db)
DATABASE_URL=

# AWS S3 Storage Settings (Set USE_S3=True when deploying to cloud)
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
